{
  "name": "returnfast-customer-account",
  "private": true,
  "type": "module",
  "scripts": {
    "generate:portal-config": "node scripts/write-portal-config.mjs",
    "generate:portal-config:local": "node scripts/write-portal-config.mjs local",
    "generate:portal-config:dev": "node scripts/write-portal-config.mjs dev",
    "generate:portal-config:prod": "node scripts/write-portal-config.mjs prod",
    "pretypecheck": "npm run generate:portal-config",
    "typecheck": "tsc --noEmit",
    "prebuild:helpers": "npm run generate:portal-config",
    "build:helpers": "tsc src/returnPortalUrl.ts src/runtime.ts src/returnPermission.ts src/portalConfig.generated.ts --noEmit false --outDir dist --module NodeNext --moduleResolution NodeNext --target ES2022 --strict --skipLibCheck --types vite/client --lib DOM,ES2022",
    "test:url": "npm run build:helpers && node src/returnPortalUrl.test.mjs",
    "test:permission": "npm run build:helpers && node src/returnPermission.test.mjs",
    "test:runtime": "npm run build:helpers && node src/runtime.test.mjs"
  },
  "dependencies": {
    "@preact/signals": "^2.3.0",
    "@shopify/ui-extensions": "2026.7.0",
    "preact": "^10.10.0"
  },
  "devDependencies": {
    "typescript": "^5.9.3"
  }
}
